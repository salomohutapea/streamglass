export type FieldSource = 'response'|'request'|'event'|'responseHeader'|'requestHeader';
export type FieldLocation = {pattern:string;method:string;source:FieldSource;path:string};
export type CustomField = {id:string;name:string;locations:FieldLocation[]};
export type FieldResult = {id:string;name:string;locations:{source:FieldSource;path:string}[];values:string[];summaries?:(string|null)[];count:number;state:'found'|'missing'|'pending'|'unknown';limited:boolean;note?:string};
export type FieldChip = {id:string;name:string;value:string;full:string;more:number;limited:boolean};
export const fieldSources:{id:FieldSource;label:string;kind:'json'|'header';tab:'request'|'response'|'events'}[];
export function sourceLabel(id:string):string;
export function isHeaderSource(id:string):boolean;
export function urlWildcard(url:string):string;
export function newLocation(patch?:Partial<FieldLocation>):FieldLocation;
export function newField(patch?:Partial<CustomField>,location?:Partial<FieldLocation>):CustomField;
export function isDefaultLocation(location:FieldLocation):boolean;
export function changeSource(location:FieldLocation,source:FieldSource):FieldLocation;
export function wildcardMatches(pattern:string,text:string):boolean;
export function locationMatches(location:FieldLocation,record:{url?:string;method?:string}|null|undefined):boolean;
export function pickInto(field:CustomField,active:number,record:{url:string;method:string},source:FieldSource,path:string):{field:CustomField;index:number;added:boolean}|null;
export function locationText(location:{source:string;path:string}):string;
export function fieldName(path:string):string;
export function fieldChips(fields:FieldResult[]|undefined):FieldChip[];
export function chipText(chip:FieldChip):string;
export function chipTitle(chip:FieldChip):string;
export function needsFullValues(fields:FieldResult[]|undefined):boolean;
export function prettyValue(value:string):string|null;
export function fieldsColumnValue(fields:FieldResult[]|undefined):string|undefined;
export function fieldsForTab(fields:FieldResult[]|undefined,tab:string):FieldResult[];
export function stateText(field:FieldResult):string;
export function moveField<T extends {id:string}>(fields:T[],id:string,targetId:string,after:boolean):T[];
export function moveFieldBy<T extends {id:string}>(fields:T[],id:string,step:number):T[];
export function placeField<T extends {id:string}>(serverFields:T[],localFields:T[],field:T):T[];
export function orderLike<T extends {id:string}>(serverFields:T[],localFields:T[]):T[];
